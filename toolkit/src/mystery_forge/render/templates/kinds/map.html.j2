{% from "macros.html.j2" import page_label %}
<article class="prop prop-full map">
  <header class="map-cartouche">
    <h1 class="map-title">{{ page.title }}</h1>
    {% if f.get("place") %}<p class="map-place">{{ f.get("place") }}</p>{% endif %}
  </header>
  <div class="doc-body map-body">{{ page.html }}</div>
  <footer class="map-foot">
    <svg class="compass" viewBox="0 0 40 40" aria-hidden="true"><circle cx="20" cy="20" r="17"/><path d="M20 3l4 17-4 17-4-17z"/><path class="compass-north" d="M20 3l4 17h-8z"/><text x="20" y="2.5" text-anchor="middle">N</text></svg>
    {% if f.get("scale") %}<p class="map-scale"><span class="scale-bar" aria-hidden="true"></span>{{ t("field_scale") }}: {{ f.get("scale") }}</p>{% endif %}
  </footer>
  {{ page_label(t, page) }}
</article>
