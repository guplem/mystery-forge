{% from "macros.html.j2" import page_label %}
<article class="prop prop-full report">
  <header class="report-head">
    <div class="report-seal" aria-hidden="true"><svg viewBox="0 0 40 40"><circle cx="20" cy="20" r="18"/><circle cx="20" cy="20" r="13"/><path d="M20 9l3.2 6.6 7.2 1-5.2 5 1.3 7.2L20 25.4l-6.5 3.4 1.3-7.2-5.2-5 7.2-1z"/></svg></div>
    <div class="report-titles">
      <p class="report-station">{{ f.get("station") or t("word_report") }}</p>
      <h1 class="report-title">{{ page.title }}</h1>
    </div>
  </header>
  {% if page.page_number == 1 %}
  <div class="form-boxes">
    <div class="form-box"><span class="field-label">{{ t("field_case_number") }}</span><span class="field-value">{{ f.get("case_number", "") }}</span></div>
    <div class="form-box"><span class="field-label">{{ t("field_date") }}</span><span class="field-value">{{ f.get("date", "") }}</span></div>
    <div class="form-box"><span class="field-label">{{ t("field_officer") }}</span><span class="field-value">{{ f.get("officer", "") }}</span></div>
    {% if f.get("subject") %}<div class="form-box form-box-wide"><span class="field-label">{{ t("field_subject") }}</span><span class="field-value">{{ f.get("subject") }}</span></div>{% endif %}
  </div>
  {% endif %}
  <div class="doc-body report-body">{{ page.html }}</div>
  <footer class="report-foot"><span class="sign-line"></span><span class="field-label">{{ t("field_officer") }}</span></footer>
  {{ page_label(t, page) }}
</article>
