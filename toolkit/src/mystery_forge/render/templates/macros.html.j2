{% macro scissors_icon() -%}
<svg class="icon icon-scissors" viewBox="0 0 24 24" aria-hidden="true"><circle cx="6" cy="6" r="3"/><circle cx="6" cy="18" r="3"/><path d="M20 4 8.1 15.9M14.5 14.5 20 20M8.1 8.1 12 12"/></svg>
{%- endmacro %}
{% macro fold_icon() -%}
<svg class="icon icon-fold" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20V8l6-4v12z"/><path d="M10 4h10v16H4"/></svg>
{%- endmacro %}
{% macro warning_icon() -%}
<svg class="icon icon-warning" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 2 21h20z"/><path d="M12 10v5M12 17.5v.5"/></svg>
{%- endmacro %}
{% macro check_box() -%}
<span class="check-box" aria-hidden="true"></span>
{%- endmacro %}
{% macro ornament() -%}
<svg class="ornament" viewBox="0 0 120 12" aria-hidden="true"><path d="M2 6h46M72 6h46"/><path d="M60 1l5 5-5 5-5-5z"/><circle cx="50" cy="6" r="1.4"/><circle cx="70" cy="6" r="1.4"/></svg>
{%- endmacro %}
{% macro emblem() -%}
<svg class="emblem" viewBox="0 0 120 120" aria-hidden="true">
  <circle class="emblem-ring" cx="60" cy="60" r="57"/>
  <circle class="emblem-ring-thin" cx="60" cy="60" r="51"/>
  <g class="emblem-dots">{% for angle in range(0, 360, 30) %}<circle cx="60" cy="6" r="1.3" transform="rotate({{ angle }} 60 60)"/>{% endfor %}</g>
  <circle class="emblem-glass" cx="54" cy="52" r="21"/>
  <circle class="emblem-glass-inner" cx="54" cy="52" r="16.5"/>
  <path class="emblem-handle" d="M69 67 88 86"/>
  <text class="emblem-mark" x="54" y="61" text-anchor="middle">?</text>
</svg>
{%- endmacro %}
{% macro field_row(t, fields, name) -%}
{% if fields.get(name) %}<div class="field-row field-{{ name }}"><span class="field-label">{{ t("field_" ~ name) }}</span><span class="field-value">{{ fields[name] }}</span></div>{% endif %}
{%- endmacro %}
{% macro page_label(t, page) -%}
{% if page.page_count > 1 %}<div class="doc-page-label">{{ t("page_label", number=page.page_number, count=page.page_count) }}</div>{% endif %}
{%- endmacro %}
