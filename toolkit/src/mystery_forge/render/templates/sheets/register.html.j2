<div class="safe register-page">
  <header class="sheet-header">
    <p class="sheet-kicker">{{ t("materials_title") }}</p>
    <h1>{{ t("register_title") }}</h1>
  </header>
  {% if content.first %}<p class="sheet-intro">{{ t("register_intro") }}</p>{% endif %}
  <div class="register-columns">
    {% for entry in content.entries %}
    <div class="register-entry"><span class="register-answer">{{ entry.text }}</span><span class="register-leader" aria-hidden="true"></span><span class="register-number">§{{ entry.paragraph }}</span></div>
    {% endfor %}
  </div>
</div>
