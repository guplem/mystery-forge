{% from "macros.html.j2" import ornament %}
<div class="safe section-page">
  <header class="sheet-header">
    <p class="sheet-kicker">{{ t("solutions_title") }}</p>
    <h1>{{ t("epilogues_title") }}</h1>
  </header>
  {% for epilogue in content.epilogues %}
  <div class="epilogue">
    <p class="epilogue-threshold">{{ t("epilogue_threshold", percent=epilogue.min_score_percent) }}</p>
    <h2 class="epilogue-title">{{ epilogue.title }}</h2>
    <p class="epilogue-text">{{ epilogue.text }}</p>
  </div>
  {% endfor %}
  <footer class="manual-credit">{{ ornament() }}<p class="cover-credit">{{ t("made_with") }}</p></footer>
</div>
