<div class="safe characters-page">
  <header class="sheet-header">
    <p class="sheet-kicker">{{ t("materials_title") }}</p>
    <h1>{{ t("characters_title") }}</h1>
  </header>
  {% if content.first %}<p class="sheet-intro">{{ t("characters_intro") }}</p>{% endif %}
  <div class="character-cards">
    {% for card in content.cards %}
    <section class="character-card">
      <div class="character-top">
        <div class="character-portrait{% if not card.drawn %} character-portrait-plain{% endif %}">{{ card.portrait }}</div>
        <div class="character-facts">
          <h2 class="character-name">{{ card.name }}</h2>
          <p class="character-role">{{ card.role }}</p>
          <p class="character-field"><span>{{ t("character_time") }}</span></p>
          <p class="character-field"><span>{{ t("character_places") }}</span></p>
          <p class="character-field"></p>
        </div>
      </div>
      <p class="character-notes-label">{{ t("character_notes") }}</p>
      <div class="notes-lines character-notes"></div>
    </section>
    {% endfor %}
  </div>
</div>
