<div class="safe solution-page">
  <header class="sheet-header solution-header">
    <div class="puzzle-badge inline"><span>{{ t("puzzle_badge") }}</span><strong>{{ content.code }}</strong></div>
    <h1>{{ content.title }}</h1>
  </header>
  <div class="answer-box">
    <p class="answer-label">{{ t("solution_answer") }}</p>
    <p class="answer-text">{{ content.answer }}</p>
    {% if content.accepted %}<p class="answer-accepted">{{ t("solution_accepted") }}: {{ content.accepted | join(" · ") }}</p>{% endif %}
  </div>
  <h2 class="section-title">{{ t("solution_steps") }}</h2>
  <ol class="explained-list">
    {% for step in content.steps %}
    <li>{% include "sheets/explained.html.j2" %}</li>
    {% endfor %}
  </ol>
</div>
